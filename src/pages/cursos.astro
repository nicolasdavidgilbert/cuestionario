---
import Layout from '../layouts/Layout.astro'
import { neon } from '@neondatabase/serverless'
import { getAdsenseConfig, getDatabaseUrl } from '../lib/server/env'
import { getCourseInfo, getGradeInfo } from '../lib/curriculum'
import AdSenseAd from '../components/AdSenseAd'
import { getFeedAdPositions } from '../lib/feedAds'

export const prerender = false

interface QuizRow {
  grado: string
  course_id: string
  unidad: string | null
  title: string | null
}

interface ServedUnit { id: string; title: string }
interface ServedCourse { id: string; units: ServedUnit[] }
interface ServedGrade { id: string; courses: ServedCourse[] }

let catalog: ServedGrade[] = []
let totalUnits = 0
let catalogLoadFailed = false
try {
  const sql = neon(getDatabaseUrl())
  const rows = await sql`
    SELECT grado, course_id, unidad, title
    FROM user_quizzes
    WHERE deleted_at IS NULL
      AND grado IS NOT NULL
      AND course_id IS NOT NULL
    ORDER BY grado, course_id, unidad
  `
  const gradeMap = new Map<string, ServedGrade>()
  for (const raw of rows as QuizRow[]) {
    if (!raw.grado || !raw.course_id) continue
    const unit = (raw.unidad || raw.course_id)
    let grade = gradeMap.get(raw.grado)
    if (!grade) {
      grade = { id: raw.grado, courses: [] }
      gradeMap.set(raw.grado, grade)
    }
    let course = grade.courses.find((c) => c.id === raw.course_id)
    if (!course) {
      course = { id: raw.course_id, units: [] }
      grade.courses.push(course)
    }
    if (!course.units.some((u) => u.id === unit)) {
      course.units.push({ id: unit, title: raw.title || '' })
      totalUnits += 1
    }
  }
  catalog = Array.from(gradeMap.values())
} catch (error) {
  catalogLoadFailed = true
  console.error('SSR cursos lookup error:', error)
}

if (catalogLoadFailed) {
  Astro.response.status = 503
}

const { client: adsenseClient, enabledByEnv: adsEnabledByEnv } = getAdsenseConfig()
const feedAdSlot = import.meta.env.PUBLIC_ADSENSE_INFEED_SLOT || '4088985404'
const feedAdLayoutKey = import.meta.env.PUBLIC_ADSENSE_INFEED_LAYOUT_KEY || '-fc+50+9g-c8-9k'
const feedAdPositions = getFeedAdPositions(catalog.length)
---

<Layout
  title="Tests de ASIR por curso y asignatura"
  description="Tests tipo test con soluciones explicadas para 1.º y 2.º de ASIR, organizados por curso, asignatura y tema."
  robots={catalogLoadFailed ? 'noindex, nofollow' : 'index, follow'}
>
  <div class="page-wrap courses-page">
    <nav class="breadcrumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <span>Cursos</span>
    </nav>

    <header class="home-header courses-header">
      <p class="section-kicker">Catálogo</p>
      <h1>Cursos disponibles</h1>
      {catalog.length > 0 ? (
        <p>{totalUnits} tema{totalUnits === 1 ? '' : 's'} en {catalog.length} curso{catalog.length === 1 ? '' : 's'}.</p>
      ) : (
        <p>Explora los cuestionarios tipo test organizados por asignatura y unidad.</p>
      )}
      {/* Plegado: sigue en el HTML para buscadores, pero no llena la página de texto */}
      <details class="more-info">
        <summary>Sobre estos cuestionarios</summary>
        <div class="more-info__body">
          <p>
            Cuestionarios para preparar el ciclo de grado superior de Administración de Sistemas Informáticos en Red (ASIR).
            Cada tema incluye todas sus preguntas con la respuesta correcta y una explicación, y un modo test aleatorio
            para comprobar lo que sabes antes del examen.
          </p>
          {!catalogLoadFailed && catalog.length > 0 && (
            <dl class="more-info__list">
              {catalog.map((grade) => (
                <div>
                  <dt>{getGradeInfo(grade.id).name}</dt>
                  <dd>{getGradeInfo(grade.id).description}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </details>
    </header>

    {catalogLoadFailed ? (
      <div class="error-msg" role="status">
        El catálogo no está disponible temporalmente. Inténtalo de nuevo más tarde.
      </div>
    ) : catalog.length > 0 ? (
      <section class="grade-grid" aria-label="Lista de grados con cuestionarios">
        {catalog.map((grade, gradeIndex) => {
          const unitsInGrade = grade.courses.reduce((sum, c) => sum + c.units.length, 0)
          const coursesInGrade = grade.courses.length
          return (
            <>
            <a href={`/${grade.id}`} class="grado-card">
              <article class="grado-card-main">
                <div class="grado-info">
                  <span class="grado-label">{getGradeInfo(grade.id).name}</span>
                  <span class="grado-meta">
                    {coursesInGrade} asignatura{coursesInGrade === 1 ? '' : 's'} · {unitsInGrade} tema{unitsInGrade === 1 ? '' : 's'}
                  </span>
                </div>
                <span class="grado-card-cta">Entrar <span class="grado-arrow" aria-hidden="true">→</span></span>
              </article>
            </a>
            {feedAdPositions.has(gradeIndex) && (
              <AdSenseAd
                client:idle
                variant="feed"
                className="grado-card"
                slot={feedAdSlot}
                layoutKey={feedAdLayoutKey}
                clientId={adsenseClient}
                enabledByEnv={adsEnabledByEnv}
              />
            )}
            </>
          )
        })}
      </section>
    ) : null}

    {!catalogLoadFailed && catalog.map((grade) => (
      <section class="course-section" aria-labelledby={`grade-${grade.id}`}>
        <h2 id={`grade-${grade.id}`}>{getGradeInfo(grade.id).name}</h2>
        <div class="unit-grid">
          {grade.courses.map((course) => (
            <a href={`/${grade.id}#${course.id}`} class="unit-card">
              <article>
                <strong>{getCourseInfo(course.id).name}</strong>
                <span class="unit-title"><span class="card-tag">{course.id.toUpperCase()}</span> · {course.units.length} tema{course.units.length === 1 ? '' : 's'}</span>
              </article>
              <span class="unit-action">Ver temas</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    {!catalogLoadFailed && catalog.length === 0 && (
      <div class="empty-state">
        <div class="empty-icon" />
        <p>No hay cuestionarios publicados todavía.</p>
        <a href="/crear" class="btn-primary">Crear el primero</a>
      </div>
    )}
  </div>
</Layout>
