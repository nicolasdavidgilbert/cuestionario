---
import Layout from '../layouts/Layout.astro'
import { FAQ_ITEMS } from '../components/Landing.jsx'
import AdSenseAd from '../components/AdSenseAd'
import { getAdsenseConfig } from '../lib/server/env'
import LandingCourses from '../components/LandingCourses.jsx'
import { neon } from '@neondatabase/serverless'
import { getDatabaseUrl } from '../lib/server/env'
import { getCourseName, getGradeInfo } from '../lib/curriculum'

const { client: adsenseClient, enabledByEnv: adsEnabledByEnv } = getAdsenseConfig()

// Listado de temas renderizado en el servidor: el buscador se monta en el navegador,
// así que sin esto la portada no enlazaría a ningún tema en el HTML.
interface TopicRow { grado: string; course_id: string; unidad: string | null; title: string | null; question_count: number | null }
let topicsByGrade: { grado: string; topics: { href: string; title: string; course: string; questions: number }[] }[] = []
try {
  const sql = neon(getDatabaseUrl())
  const rows = await sql`
    SELECT DISTINCT ON (grado, course_id, COALESCE(NULLIF(unidad, ''), course_id))
      grado, course_id, unidad, title, json_array_length(questions::json) AS question_count
    FROM user_quizzes
    WHERE deleted_at IS NULL AND grado IS NOT NULL AND course_id IS NOT NULL
    ORDER BY grado, course_id, COALESCE(NULLIF(unidad, ''), course_id), created_at DESC, id DESC
  `
  const grouped = new Map<string, { href: string; title: string; course: string; questions: number }[]>()
  for (const row of rows as TopicRow[]) {
    const unit = row.unidad || row.course_id
    const list = grouped.get(row.grado) ?? []
    list.push({
      href: `/${row.grado}/${row.course_id}/${unit}`,
      title: row.title || unit.toUpperCase(),
      course: getCourseName(row.course_id),
      questions: Number(row.question_count) || 0
    })
    grouped.set(row.grado, list)
  }
  topicsByGrade = Array.from(grouped, ([grado, topics]) => ({ grado, topics }))
} catch (error) {
  console.error('SSR home topics error:', error)
}
---
<Layout
  title="Hacer y crear cuestionarios online"
  description="Busca, resuelve y crea cuestionarios tipo test online. Una herramienta rápida para estudiar por curso, asignatura y tema sin distracciones."
  structuredData={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Cuestionarios online',
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web',
      inLanguage: 'es',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: FAQ_ITEMS.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer
        }
      }))
    }
  ]}
>
  <div class="page-wrap landing">
    <section class="landing-search" id="catalog-section" aria-labelledby="catalog-heading">
      <header class="landing-header landing-header--centered">
        <p class="section-kicker">Cuestionarios hechos por alumnos</p>
        <h1 id="catalog-heading">Busca un cuestionario</h1>
        <p class="hero-subtitle">Encuentra tests por curso, asignatura o tema. Entra, responde y revisa resultados sin distracciones.</p>
        <div class="study-terminal" aria-label="Flujo de estudio">
          <span>&gt; selecciona asignatura</span>
          <span>&gt; responde preguntas</span>
          <span>&gt; revisa resultados</span>
        </div>
      </header>
      <LandingCourses client:visible showSearch={true} showViewAll={true} compact={true} searchMode="all" emptyUntilSearch={true} syncUrl={true} />
    </section>

    <AdSenseAd client:idle slot={import.meta.env.PUBLIC_ADSENSE_SLOT || "4731901740"}  className="ad-slot ad-slot--wide" clientId={adsenseClient} enabledByEnv={adsEnabledByEnv} />

    {topicsByGrade.length > 0 && (
      <section class="landing-topics" aria-labelledby="topics-heading">
        <div class="section-heading">
          <p class="section-kicker">Temas</p>
          <h2 id="topics-heading">Tests de ASIR con soluciones explicadas</h2>
          <p>Cada tema incluye todas sus preguntas con la respuesta correcta y una explicación, y un test aleatorio para practicar.</p>
        </div>
        {topicsByGrade.map(({ grado, topics }) => (
          <section class="course-section">
            <h3><a href={`/${grado}`}>{getGradeInfo(grado).name}</a></h3>
            <div class="unit-grid">
              {topics.map((topic) => (
                <a href={topic.href} class="unit-card">
                  <article>
                    <strong>{topic.title}</strong>
                    <span class="unit-title"><span class="card-tag">{topic.course}</span> · {topic.questions} preguntas con soluciones</span>
                  </article>
                  <span class="unit-action">Repasar</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </section>
    )}

    <section class="landing-catalog" aria-labelledby="create-heading">
      <div class="section-heading">
        <p class="section-kicker">Crear</p>
        <h2 id="create-heading">Crea cuestionarios para estudiar</h2>
        <p>Si no encuentras lo que necesitas, puedes crear un cuestionario desde tus apuntes, un PDF o un JSON revisado.</p>
      </div>
      <nav class="user-actions" aria-label="Crear o explorar">
        <a href="/crear" class="btn-primary">Crear cuestionario</a>
        <a href="/cursos" class="btn-secondary">Ver todos los cursos</a>
      </nav>
    </section>

    {/* Plegado: sigue en el HTML para buscadores, pero no llena la portada de texto */}
    <section class="landing-info" aria-label="Cómo funciona">
      <details class="more-info">
        <summary>Cómo funciona Cuestionarios</summary>
        <div class="more-info__body">
          <h3>Pensada para hacer cuestionarios, no para navegar menús</h3>
          <div class="content-grid">
            <article>
              <h3>Buscar</h3>
              <p>Encuentra cuestionarios por curso, asignatura o tema sin revisar listas enormes.</p>
            </article>
            <article>
              <h3>Resolver</h3>
              <p>Al abrir un cuestionario ves pregunta, opciones, progreso y resultado. Nada más.</p>
            </article>
            <article>
              <h3>Crear</h3>
              <p>Sube apuntes o pega JSON para preparar tests propios y guardarlos para estudiar.</p>
            </article>
          </div>
          <h3>Empieza en tres pasos</h3>
          <ol class="steps-list">
            <li><strong>Busca.</strong> Escribe curso, asignatura o tema.</li>
            <li><strong>Entra.</strong> Abre el curso o unidad que necesitas practicar.</li>
            <li><strong>Resuelve o crea.</strong> Contesta el test o genera uno nuevo desde tus apuntes.</li>
          </ol>
        </div>
      </details>
    </section>

    <section class="landing-faq" aria-labelledby="faq-heading">
      <div class="section-heading">
        <p class="section-kicker">Preguntas frecuentes</p>
        <h2 id="faq-heading">FAQ sobre los cuestionarios</h2>
      </div>
      <div class="faq-list">
        {FAQ_ITEMS.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
