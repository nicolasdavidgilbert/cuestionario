---
import Layout from '../../../layouts/Layout.astro'
import Quiz from '../../../components/Quiz.tsx'
import { neon } from '@neondatabase/serverless'
import { getDatabaseUrl } from '../../../lib/server/env'
import { getCourseInfo, getGradeInfo } from '../../../lib/curriculum'

export const prerender = false

const { grado, curso, unidad } = Astro.params

interface QuizRow {
  id: number
  title: string | null
  description: string | null
  questions: unknown[]
}

function hasRenderableQuestions(row: QuizRow | null): row is QuizRow {
  if (!row || !Array.isArray(row.questions) || row.questions.length === 0) return false

  return row.questions.every((item) => {
    if (!item || typeof item !== 'object') return false
    const question = item as Record<string, unknown>
    return typeof question.question === 'string'
      && question.question.trim().length > 0
      && Array.isArray(question.options)
      && question.options.length === 4
      && question.options.every((option) => typeof option === 'string' && option.trim().length > 0)
      && Number.isInteger(question.answer)
      && Number(question.answer) >= 0
      && Number(question.answer) <= 3
  })
}

let quiz: QuizRow | null = null
let quizLoadFailed = false
let relatedUnits: { unidad: string; title: string }[] = []
try {
  const sql = neon(getDatabaseUrl())
  const rows = await sql`
    SELECT id, title, description, grado, course_id, unidad, questions
    FROM user_quizzes
    WHERE grado = ${grado}
      AND course_id = ${curso}
      AND (
        unidad = ${unidad || ''}
        OR ((unidad IS NULL OR unidad = '') AND ${unidad || ''} = ${curso})
      )
      AND deleted_at IS NULL
    ORDER BY created_at DESC, id DESC
    LIMIT 1
  `
  if (rows.length > 0) {
    quiz = rows[0] as QuizRow
    // Otros temas de la misma asignatura (el más reciente de cada unidad), para enlazarlos al final.
    const related = await sql`
      SELECT DISTINCT ON (unidad) unidad, title
      FROM user_quizzes
      WHERE grado = ${grado} AND course_id = ${curso} AND deleted_at IS NULL
        AND unidad IS NOT NULL AND unidad <> '' AND unidad <> ${unidad || ''}
      ORDER BY unidad, created_at DESC, id DESC
    `
    relatedUnits = (related as { unidad: string; title: string | null }[])
      .map((row) => ({ unidad: row.unidad, title: row.title || row.unidad.toUpperCase() }))
  }
} catch (error) {
  quizLoadFailed = true
  console.error('SSR quiz lookup error:', error)
}

const renderableQuiz = hasRenderableQuestions(quiz) ? quiz : null
const hasContent = Boolean(renderableQuiz)
const quizContentInvalid = Boolean(quiz) && !hasContent

if (quizLoadFailed || quizContentInvalid) {
  Astro.response.status = 503
} else if (!quiz) {
  Astro.response.status = 404
}

const gradeInfo = getGradeInfo(grado || '')
const courseInfo = getCourseInfo(curso || '')
const questionCount = Array.isArray(quiz?.questions) ? quiz.questions.length : 0
const readableTitle = quiz?.title || [unidad, curso, grado].filter(Boolean).join(' - ')
const title = `${readableTitle}: test con soluciones · ${courseInfo.name}`
const description = (quiz?.description
  ? `${quiz.description} ${questionCount} preguntas tipo test con respuesta y explicación.`
  : `${questionCount} preguntas tipo test con soluciones explicadas sobre ${readableTitle}, de ${courseInfo.name} (${gradeInfo.name}).`
).slice(0, 160)
---

<Layout
  title={title}
  description={description}
  robots={hasContent && !quizLoadFailed ? 'index, follow' : 'noindex, nofollow'}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Inicio',
        item: new URL('/', Astro.site ?? 'https://cuestionario.online').toString()
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Cursos',
        item: new URL('/cursos', Astro.site ?? 'https://cuestionario.online').toString()
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: gradeInfo.name,
        item: new URL('/' + grado, Astro.site ?? 'https://cuestionario.online').toString()
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: courseInfo.name
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: readableTitle,
        item: new URL(Astro.url.pathname, Astro.site ?? 'https://cuestionario.online').toString()
      }
    ]
  }}
>
  {quizLoadFailed || quizContentInvalid ? (
    <div class="page-wrap">
      <div class="error-msg" role="status">
        El cuestionario no está disponible temporalmente. Inténtalo de nuevo más tarde.
      </div>
    </div>
  ) : renderableQuiz ? (
    <>
    <Quiz
      grado={grado}
      curso={curso}
      unidad={unidad}
      quizId={renderableQuiz.id}
      pageTitle={renderableQuiz.title || ''}
      questions={renderableQuiz.questions}
      description={renderableQuiz.description || ''}
      gradeName={gradeInfo.name}
      courseName={courseInfo.name}
      courseDescription={courseInfo.description}
      client:load
    />
    {relatedUnits.length > 0 && (
      <div class="page-wrap related-wrap">
        <section class="related-topics" aria-labelledby="related-heading">
          <h2 id="related-heading">Más temas de {courseInfo.name}</h2>
          <div class="unit-grid">
            {relatedUnits.map((unit) => (
              <a href={`/${grado}/${curso}/${unit.unidad}`} class="unit-card">
                <article>
                  <strong>{unit.title}</strong>
                  <span class="unit-title">{gradeInfo.name} · Test con soluciones explicadas</span>
                </article>
                <span class="unit-action">Repasar</span>
              </a>
            ))}
          </div>
        </section>
      </div>
    )}
    </>
  ) : (
    <div class="page-wrap">
      <div class="error-msg" role="status">
        No se encontró el cuestionario solicitado. <a href="/cursos">Ver cursos disponibles</a>.
      </div>
    </div>
  )}
</Layout>
