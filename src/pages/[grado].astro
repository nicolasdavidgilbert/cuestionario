---
import Layout from '../layouts/Layout.astro'
import { neon } from '@neondatabase/serverless'
import { getDatabaseUrl } from '../lib/server/env'

export const prerender = false

const { grado } = Astro.params

interface QuizRow {
  course_id: string
  unidad: string | null
  title: string | null
}

interface ServedUnit { id: string; title: string }
interface ServedCourse { id: string; units: ServedUnit[] }

let courses: ServedCourse[] = []
let courseCount = 0
let unitCount = 0
let catalogLoadFailed = false
try {
  const sql = neon(getDatabaseUrl())
  const rows = await sql`
    SELECT course_id, unidad, title
    FROM user_quizzes
    WHERE grado = ${grado}
      AND deleted_at IS NULL
      AND course_id IS NOT NULL
    ORDER BY course_id, unidad
  `
  const map = new Map<string, ServedCourse>()
  for (const row of rows as QuizRow[]) {
    if (!row.course_id) continue
    const unit = (row.unidad || row.course_id)
    let course = map.get(row.course_id)
    if (!course) {
      course = { id: row.course_id, units: [] }
      map.set(row.course_id, course)
      courseCount += 1
    }
    if (!course.units.some((u) => u.id === unit)) {
      course.units.push({ id: unit, title: row.title || '' })
      unitCount += 1
    }
  }
  courses = Array.from(map.values())
} catch (error) {
  catalogLoadFailed = true
  console.error('SSR grado lookup error:', error)
}

const hasContent = courses.length > 0
const gradoLabel = grado?.toUpperCase()

if (catalogLoadFailed) {
  Astro.response.status = 503
} else if (!hasContent) {
  Astro.response.status = 404
}
---

<Layout
  title={grado ? `Cuestionarios de ${grado}` : 'Cuestionarios por curso'}
  description={
    hasContent
      ? `Practica cuestionarios tipo test de ${grado}: ${unitCount} temas distribuidos en ${courseCount} asignaturas. Responde, revisa y aprende.`
      : `Practica cuestionarios tipo test de ${grado} organizados por curso y unidad.`
  }
  robots={hasContent && !catalogLoadFailed ? 'index, follow' : 'noindex, nofollow'}
>
  <div class="page-wrap">
    <nav class="breadcrumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/cursos">Cursos</a>
      <span aria-hidden="true">/</span>
      <span>{gradoLabel}</span>
    </nav>

    <header class="home-header">
      <p class="section-kicker">Catálogo de cuestionarios</p>
      <h1>{gradoLabel}</h1>
      {hasContent ? (
        <p>{unitCount} tema{unitCount === 1 ? '' : 's'} disponibles en {courseCount} asignatura{courseCount === 1 ? '' : 's'}.</p>
      ) : (
        <p>Elige una asignatura y unidad para empezar a practicar.</p>
      )}
    </header>

    {catalogLoadFailed ? (
      <div class="error-msg" role="status">
        El catálogo no está disponible temporalmente. Inténtalo de nuevo más tarde.
      </div>
    ) : hasContent ? (
      <section class="catalog-served" aria-label="Cuestionarios de este curso">
        {courses.map((course) => (
          <section class="course-section">
            <h2>{course.id.toUpperCase()}</h2>
            <div class="unit-grid">
              {course.units.map((unit) => (
                <a href={`/${grado}/${course.id}/${unit.id}`} class="unit-card">
                  <article>
                    <span class="unit-badge">{course.id.toUpperCase()}</span>
                    <strong>{unit.title || unit.id.toUpperCase()}</strong>
                    <span class="unit-title">Cuestionario tipo test</span>
                  </article>
                  <span class="unit-action">Empezar</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </section>
    ) : (
      <div class="empty-state">
        <div class="empty-icon" />
        <p>No se encontró ningún curso publicado con esta dirección.</p>
        <a href="/cursos" class="btn-primary">Ver cursos disponibles</a>
      </div>
    )}
  </div>
</Layout>
