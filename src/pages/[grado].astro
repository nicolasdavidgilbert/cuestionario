---
import Layout from '../layouts/Layout.astro'
import { neon } from '@neondatabase/serverless'
import { getAdsenseConfig, getDatabaseUrl } from '../lib/server/env'
import { getCourseInfo, getGradeInfo } from '../lib/curriculum'
import AdSenseAd from '../components/AdSenseAd'
import { getFeedAdPositions } from '../lib/feedAds'

export const prerender = false

const { grado } = Astro.params

interface QuizRow {
  course_id: string
  unidad: string | null
  title: string | null
  question_count: number | null
}

interface ServedUnit { id: string; title: string; questionCount: number }
interface ServedCourse { id: string; units: ServedUnit[] }

let courses: ServedCourse[] = []
let courseCount = 0
let unitCount = 0
let catalogLoadFailed = false
try {
  const sql = neon(getDatabaseUrl())
  const rows = await sql`
    SELECT DISTINCT ON (course_id, COALESCE(NULLIF(unidad, ''), course_id))
      course_id, unidad, title, json_array_length(questions::json) AS question_count
    FROM user_quizzes
    WHERE grado = ${grado}
      AND deleted_at IS NULL
      AND course_id IS NOT NULL
    ORDER BY course_id, COALESCE(NULLIF(unidad, ''), course_id), created_at DESC, id DESC
  `
  const map = new Map<string, ServedCourse>()
  for (const row of rows as QuizRow[]) {
    if (!row.course_id) continue
    const unit = (row.unidad || row.course_id)
    let course = map.get(row.course_id)
    if (!course) {
      course = { id: row.course_id, units: [] }
      map.set(row.course_id, course)
      courseCount += 1
    }
    if (!course.units.some((u) => u.id === unit)) {
      course.units.push({ id: unit, title: row.title || '', questionCount: Number(row.question_count) || 0 })
      unitCount += 1
    }
  }
  courses = Array.from(map.values())
} catch (error) {
  catalogLoadFailed = true
  console.error('SSR grado lookup error:', error)
}

const hasContent = courses.length > 0
const { client: adsenseClient, enabledByEnv: adsEnabledByEnv } = getAdsenseConfig()
const feedAdSlot = import.meta.env.PUBLIC_ADSENSE_INFEED_SLOT || '4088985404'
const feedAdLayoutKey = import.meta.env.PUBLIC_ADSENSE_INFEED_LAYOUT_KEY || '-fc+50+9g-c8-9k'
// Los anuncios se reparten por el listado completo (todas las asignaturas), no por cada una.
const feedAdPositions = getFeedAdPositions(unitCount)
const courseOffsets = courses.map((_, index) => courses.slice(0, index).reduce((sum, c) => sum + c.units.length, 0))
const gradeInfo = getGradeInfo(grado || '')
const gradoLabel = gradeInfo.name
const totalQuestions = courses.reduce((sum, course) => sum + course.units.reduce((s, unit) => s + unit.questionCount, 0), 0)

if (catalogLoadFailed) {
  Astro.response.status = 503
} else if (!hasContent) {
  Astro.response.status = 404
}
---

<Layout
  title={`Tests de ${gradeInfo.name} con soluciones`}
  description={
    hasContent
      ? `${unitCount} temas y ${totalQuestions} preguntas tipo test con soluciones explicadas de ${gradeInfo.short}, organizados por asignatura.`.slice(0, 160)
      : `Cuestionarios tipo test de ${gradeInfo.name} organizados por asignatura y tema.`
  }
  robots={hasContent && !catalogLoadFailed ? 'index, follow' : 'noindex, nofollow'}
>
  <div class="page-wrap">
    <nav class="breadcrumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/cursos">Cursos</a>
      <span aria-hidden="true">/</span>
      <span>{gradoLabel}</span>
    </nav>

    <header class="home-header">
      <p class="section-kicker">{gradeInfo.short}</p>
      <h1>Tests de {gradoLabel}</h1>
      {hasContent ? (
        <p>{unitCount} tema{unitCount === 1 ? '' : 's'} y {totalQuestions} preguntas con soluciones explicadas, en {courseCount} asignatura{courseCount === 1 ? '' : 's'}.</p>
      ) : (
        <p>Elige una asignatura y unidad para empezar a practicar.</p>
      )}
      {/* Plegado: sigue en el HTML para buscadores, pero no llena la página de texto */}
      <details class="more-info">
        <summary>Sobre este curso y sus asignaturas</summary>
        <div class="more-info__body">
          <p>{gradeInfo.description}</p>
          {hasContent && !catalogLoadFailed && (
            <dl class="more-info__list">
              {courses.filter((course) => getCourseInfo(course.id).description).map((course) => (
                <div>
                  <dt>{getCourseInfo(course.id).name}</dt>
                  <dd>{getCourseInfo(course.id).description}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </details>
    </header>

    {catalogLoadFailed ? (
      <div class="error-msg" role="status">
        El catálogo no está disponible temporalmente. Inténtalo de nuevo más tarde.
      </div>
    ) : hasContent ? (
      <section class="catalog-served" aria-label="Cuestionarios de este curso">
        {courses.map((course, courseIndex) => (
          <section class="course-section" id={course.id}>
            <h2>{getCourseInfo(course.id).name}</h2>
            <div class="unit-grid">
              {course.units.map((unit, unitIndex) => (
                <>
                  <a href={`/${grado}/${course.id}/${unit.id}`} class="unit-card">
                    <article>
                      <strong>{unit.title || unit.id.toUpperCase()}</strong>
                      <span class="unit-title"><span class="card-tag">{course.id.toUpperCase()}</span> · {unit.questionCount} preguntas con soluciones</span>
                    </article>
                    <span class="unit-action">Empezar</span>
                  </a>
                  {feedAdPositions.has(courseOffsets[courseIndex] + unitIndex) && (
                    <AdSenseAd
                      client:idle
                      variant="feed"
                      className="unit-card"
                      slot={feedAdSlot}
                      layoutKey={feedAdLayoutKey}
                      clientId={adsenseClient}
                      enabledByEnv={adsEnabledByEnv}
                    />
                  )}
                </>
              ))}
            </div>
          </section>
        ))}
      </section>
    ) : (
      <div class="empty-state">
        <div class="empty-icon" />
        <p>No se encontró ningún curso publicado con esta dirección.</p>
        <a href="/cursos" class="btn-primary">Ver cursos disponibles</a>
      </div>
    )}
  </div>
</Layout>
