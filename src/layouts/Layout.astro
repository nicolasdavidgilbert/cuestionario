---
import AdSenseManager from '../components/AdSenseManager'
import CookieConsentBanner from '../components/CookieConsentBanner'
import { getAdsenseConfig } from '../lib/server/env'
import { canServeAdsOnPage } from '../lib/ads'

interface Props {
  title?: string
  description?: string
  image?: string
  robots?: 'index, follow' | 'noindex, nofollow'
  structuredData?: Record<string, unknown> | Record<string, unknown>[]
}

const SITE_NAME = 'Cuestionarios'
const DEFAULT_DESCRIPTION = 'Practica cuestionarios tipo test por curso, asignatura y unidad. Estudia con una interfaz clara, rápida y centrada en responder.'

const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  image = '/assets/favicon.png',
  robots = 'index, follow',
  structuredData
} = Astro.props

const { client: adsenseClient, enabledByEnv: adsEnabledByEnv } = getAdsenseConfig()
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://cuestionario.online').toString()
const absoluteImageUrl = new URL(image, Astro.site ?? 'https://cuestionario.online').toString()
const currentYear = new Date().getFullYear()
const adsOnThisPage = canServeAdsOnPage(Astro.url.pathname, adsEnabledByEnv, adsenseClient)
const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`
const currentPath = Astro.url.pathname
const navLinks = [
  { href: "/cursos", label: "Cursos" },
  { href: "/mis-cuestionarios", label: "Mis cuestionarios" },
  { href: "/prompt", label: "Prompt IA" }
]
const themeOptions = [
  { value: 'light', label: 'Tema claro', icon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>' },
  { value: 'dark', label: 'Tema oscuro', icon: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>' },
  { value: 'system', label: 'Tema del sistema', icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>' }
]
const isActivePath = (href: string) => {
  if (href === "/cursos" && Astro.params.grado) return true
  return currentPath === href || currentPath.startsWith(`${href}/`)
}
const baseStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: new URL('/', Astro.site ?? 'https://cuestionario.online').toString(),
  description: DEFAULT_DESCRIPTION,
  inLanguage: 'es'
}
const jsonLd = structuredData
  ? Array.isArray(structuredData)
    ? [baseStructuredData, ...structuredData]
    : [baseStructuredData, structuredData]
  : [baseStructuredData]
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={`${robots}, max-snippet:160, max-image-preview:large`} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f0f12" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Aplica el tema guardado antes del primer pintado para que no parpadee -->
    <script is:inline>
      (function () {
        var theme = null
        try { theme = localStorage.getItem('cuestionario.theme') } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') return
        document.documentElement.dataset.theme = theme
        var color = theme === 'dark' ? '#0f0f12' : '#fafafa'
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) { meta.content = color })
      })()
    </script>
  </head>
  <body>
    <div id="root">
      <header class="site-header">
        <div class="site-header__inner">
          <a href="/" class="site-brand" aria-label="Ir al inicio">
            <span class="site-brand__mark" aria-hidden="true">?</span>
            <span>{SITE_NAME}</span>
          </a>
          <nav class="site-nav" aria-label="Navegación principal">
            {navLinks.map((link) => (
              <a
                href={link.href}
                class:list={{ "is-active": isActivePath(link.href) }}
                aria-current={isActivePath(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
            <a
              href="/crear"
              class:list={{ "site-nav__cta": true, "is-active": isActivePath("/crear") }}
              aria-current={isActivePath("/crear") ? "page" : undefined}
            >
              Crear
            </a>
          </nav>
          <fieldset class="theme-switch">
            <legend class="sr-only">Tema</legend>
            {themeOptions.map((option) => (
              <label title={option.label}>
                <input class="sr-only" type="radio" name="theme" value={option.value} checked={option.value === 'system'} />
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={option.icon} />
                <span class="sr-only">{option.label}</span>
              </label>
            ))}
          </fieldset>
        </div>
      </header>
      <main class="site-shell">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__inner">
          <p class="site-footer__brand">{SITE_NAME}</p>
          <nav class="site-footer__links" aria-label="Enlaces legales">
            <a href="/sobre">Sobre el proyecto</a>
            <a href="/privacy-policy">Política de privacidad</a>
            <a href="/terms">Términos</a>
            <a href="/contact">Contacto</a>
          </nav>
          <p class="site-footer__meta">
            © {currentYear} cuestionario.online. Los anuncios y las opciones de privacidad se gestionan con Google AdSense.
          </p>
        </div>
      </footer>
    </div>
    {adsOnThisPage && <AdSenseManager client:idle clientId={adsenseClient} enabledByEnv={adsEnabledByEnv} />}
    <CookieConsentBanner client:idle enabled={adsOnThisPage} />
    <script>
      import { prefersReducedMotion } from '../lib/motion'

      const STORAGE_KEY = 'cuestionario.theme'
      const THEME_COLORS = { light: '#fafafa', dark: '#0f0f12' }
      type ThemeChoice = 'light' | 'dark' | 'system'

      function readChoice(): ThemeChoice {
        try {
          const value = localStorage.getItem(STORAGE_KEY)
          return value === 'light' || value === 'dark' ? value : 'system'
        } catch {
          return 'system'
        }
      }

      function applyChoice(choice: ThemeChoice) {
        const root = document.documentElement
        const metas = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')
        if (choice === 'system') {
          delete root.dataset.theme
          metas.forEach((meta) => {
            meta.content = meta.media.includes('dark') ? THEME_COLORS.dark : THEME_COLORS.light
          })
        } else {
          root.dataset.theme = choice
          metas.forEach((meta) => { meta.content = THEME_COLORS[choice] })
        }
      }

      function syncRadios(choice: ThemeChoice) {
        document.querySelectorAll<HTMLInputElement>('.theme-switch input').forEach((input) => {
          input.checked = input.value === choice
        })
      }

      syncRadios(readChoice())

      document.querySelector('.theme-switch')?.addEventListener('change', (event) => {
        const choice = (event.target as HTMLInputElement).value as ThemeChoice
        try {
          if (choice === 'system') localStorage.removeItem(STORAGE_KEY)
          else localStorage.setItem(STORAGE_KEY, choice)
        } catch {
          // Sin almacenamiento el tema se aplica igualmente en esta página
        }
        // Fundido entre temas en vez de un salto brusco de brillo
        if (document.startViewTransition && !prefersReducedMotion()) {
          document.startViewTransition(() => applyChoice(choice))
        } else {
          applyChoice(choice)
        }
      })

      // Otra pestaña cambió el tema
      window.addEventListener('storage', (event) => {
        if (event.key !== STORAGE_KEY) return
        const choice = readChoice()
        applyChoice(choice)
        syncRadios(choice)
      })
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
