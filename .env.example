DATABASE_URL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Panel /admin: hash de la contraseña (genéralo con `pnpm admin:password`). Sin él, el panel está cerrado.
ADMIN_PASSWORD_HASH=
# Clave técnica solo para scripts (exportación y borrado). Nunca se envía al navegador.
ADMIN_API_KEY=
CRON_SECRET=

PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT=XXXXXXX
# Opcional: bloque "In-feed" de AdSense para los anuncios integrados en los listados (/cursos, /[grado]).
# Por defecto se usa el bloque "In-feed listados cursos" (4088985404).
PUBLIC_ADSENSE_INFEED_SLOT=
PUBLIC_ADSENSE_INFEED_LAYOUT_KEY=
PUBLIC_ENABLE_ADS=false
PUBLIC_CONTACT_EMAIL=contacto@cuestionario.online
SENTRY_AUTH_TOKEN=
